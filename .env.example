# ---------------------------------------------------------------------------
# Orbit website — local development environment.
#
# Copy .env.example to .env and adjust.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=orbit-website
SITE_HTTP_PORT=8120
IMAGE_TAG=local

# Where the enterprise guide form posts its leads.
#
# Leave this empty and the form falls back to opening the visitor's mail client
# with the enquiry pre-filled — which still reaches a person. Set it to an
# endpoint accepting a JSON POST and the form submits directly.
#
# NEXT_PUBLIC_ values are inlined into the JavaScript bundle at build time, so
# this is public. Never point it at anything that needs a secret to call.
NEXT_PUBLIC_LEAD_ENDPOINT=http://localhost:8080/v1/admin/leads/capture

# The API origin the lead form posts to. It has to be named in the site's
# Content-Security-Policy, because connect-src 'self' blocks a cross-origin POST — and a
# CSP block is invisible to the visitor: the form just says it did not work.
#
# Empty in local development: the form talks to localhost:8080, which the browser treats
# as a different origin, so set it there too if you are testing the container.
ORBIT_API_ORIGIN=http://localhost:8080
